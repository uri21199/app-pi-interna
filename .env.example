# --- Cliente (Vite las inyecta en el build, terminan en el bundle público) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=

# --- Solo servidor (funciones en server/; NUNCA prefijar con VITE_) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Par de claves VAPID para Web Push — generar una vez con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# y no reusar las de otro entorno (identifican al servidor ante los navegadores).
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
